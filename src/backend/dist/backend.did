type ValueEntry = 
 record {
   name: text;
   unit: text;
   value: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type SavedCalculation = 
 record {
   calculator: text;
   createdAt: Timestamp;
   id: CalculationId;
   inputs: vec ValueEntry;
   outputs: vec ValueEntry;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type MaterialProperty = 
 record {
   unit: text;
   value: float64;
 };
type MaterialCategory = 
 variant {
   aluminum;
   plastic;
   steel;
 };
type Material = 
 record {
   category: MaterialCategory;
   density: MaterialProperty;
   grade: text;
   modulusOfElasticity: MaterialProperty;
   name: text;
   thermalConductivity: MaterialProperty;
   thermalExpansion: MaterialProperty;
   yieldStrength: MaterialProperty;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type CalculationId = nat;
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  deleteCalculation: (id: CalculationId) -> (bool);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  isCallerAdmin: () -> (bool) query;
  listCalculations: () -> (vec SavedCalculation) query;
  listMaterials: () -> (vec Material) query;
  saveCalculation: (calculator: text, inputs: vec ValueEntry, outputs:
   vec ValueEntry) -> (CalculationId);
  schema: () -> (text) query;
}
